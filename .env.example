# Copy to .env and fill in your own keys. Never commit .env.

# --- Provider credentials ---
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Models ---
# Generation: Grounded answers from retrieved context.
CHAT_MODEL=openai/gpt-oss-120b
# Classification: only invoked when the embedding router cannot separate two
# domains on its own.
INTENT_MODEL=openai/gpt-oss-20b
MODEL_PROVIDER=groq
# Changing this requires re-running `company-rag --ingest`.
EMBED_MODEL=gemini-embedding-001

# --- Storage and retrieval ---
CHROMA_DIR=./chroma_store
DATA_DIR=./data
RETRIEVAL_K=5